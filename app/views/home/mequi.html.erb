<div id='wrapper'>
    <div id="value">00</div>
    <%= image_tag('yellow_line.png', width: '100%', style: 'margin-bottom: 50px' )%>
    <div id='btn-wrapper'>
        <a id='btn' class='btn' onclick="draw();">sortear</a>
    </div>
</div>
<script>
    let ary = <%= @ary%>;
    let drawed_index = null;
    
    function draw() {
        console.log(ary);
        const obj = document.getElementById('value');
        animateValue(obj, ary, Math.floor(Math.random() * 1000 + 2000))        
    }

    function animateValue(obj, ary, duration) {
        const startTimestamp = document.timeline.currentTime;
        const step = (timestamp) => {
            const progress = Math.min((timestamp - startTimestamp) / duration, 1);
            drawed_index = Math.floor(Math.random() * ary.length);
            obj.innerHTML = ary[drawed_index];
            if (progress === 1) { 
                ary.splice(drawed_index, 1);
            } else {
                window.requestAnimationFrame(step);
            }          
        };
        window.requestAnimationFrame(step);
    }
</script>